{
  "expo": {
    "name": "Fitly",
    "slug": "fitly",
    "scheme": "fitly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.fitly.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Fitly uses your camera to add clothes and body photos to your private wardrobe.",
        "NSPhotoLibraryUsageDescription": "Fitly uses selected photos to build your private wardrobe and create try-ons.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.fitly.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your private Fitly wardrobe.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos for your private Fitly wardrobe."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac7a88d2-7cf9-49da-8e55-e03dc63e7618"
      }
    }
  }
}
