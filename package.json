{
  "name": "community-wardrobe",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.101.4",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "react-native-web": "^0.21.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "check:pii": "node scripts/check-pii.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:db": "supabase test db"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "collectCoverageFrom": [
      "src/features/auth/**/*.{ts,tsx}",
      "src/features/account/**/*.{ts,tsx}",
      "src/features/body-photos/**/*.{ts,tsx}",
      "src/features/garments/**/*.{ts,tsx}",
      "src/features/tryon/**/*.{ts,tsx}",
      "src/i18n/**/*.{ts,tsx}",
      "src/lib/observability.ts",
      "src/components/AppErrorBoundary.tsx",
      "src/components/PrivacyVisibilityLine.tsx",
      "src/providers/AuthProvider.tsx",
      "src/providers/MotionPreferenceProvider.tsx",
      "supabase/functions/process-garment/{handler,processor,removeBgProvider,geminiTaggingProvider}.ts",
      "supabase/functions/tryon-enqueue/{handler,processor,geminiProvider}.ts",
      "supabase/functions/validate-body-photo/{handler,processor,geminiModerationProvider}.ts",
      "supabase/functions/delete-account/{handler,deleteAccount}.ts",
      "supabase/functions/delete-body-photo/{handler,deleteBodyPhoto}.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "overrides": {
    "react-native-reanimated": "$react-native-reanimated",
    "react-native-worklets": "$react-native-worklets"
  },
  "private": true
}
