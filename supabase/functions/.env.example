# Keep real values in Supabase Edge Function secrets or an ignored local .env file.
REMOVE_BG_API_KEY=
REMOVE_BG_COST_USD=
OPENROUTER_API_KEY=
# Defaults are privacy-focused: the pinned Google Vertex endpoint currently supports ZDR.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_IMAGE_PROVIDER=google-vertex/global
# Used only when OpenRouter does not include usage.cost in the response.
OPENROUTER_TRYON_COST_USD_FALLBACK=0.10
# Must stay below the ten-minute stale-job reconciliation window.
OPENROUTER_TRYON_TIMEOUT_MS=90000
# Safe default: the outbox worker defers rows without spending retry attempts.
EXPO_PUSH_ENABLED=false
# Optional when Expo enhanced push security is enabled for the EAS project.
EXPO_ACCESS_TOKEN=
# Aggregate operational-health thresholds. No member or resource identifiers
# are returned by the health endpoint or retained in its snapshots.
# Independent high-entropy monitor credential; never use a Supabase service key.
OPERATIONS_HEALTH_ACCESS_TOKEN=
OPERATIONS_HEALTH_STALE_MINUTES=15
OPERATIONS_HEALTH_WARNING_COUNT=1
OPERATIONS_HEALTH_CRITICAL_COUNT=10
